{
  "name": "verdemais",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run build:server && npm run build:cron",
    "build:server": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-node/server.js",
    "build:cron": "esbuild src/cron.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-node/cron.js",
    "start": "node dist-node/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
    "db:status": "node scripts/migrate.mjs --status",
    "db:importar-d1": "node scripts/migrar-d1-para-neon.mjs",
    "cron": "node dist-node/cron.js"
  },
  "dependencies": {
    "hono": "^4.12.5",
    "@hono/node-server": "^1.13.7",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "esbuild": "^0.24.2"
  },
  "engines": {
    "node": ">=20"
  },
  "description": "VerdeMais — SaaS de finanças pessoais (Hono + Node + Postgres/Neon)",
  "private": true
}